---
import {
  textLanguage,
  translator,
  localizedPath,
  languageFromPath,
} from "../lib/i18n";
import Site from "../layouts/Site.astro";
const t = translator(Astro.url.pathname);
const local = (path: string) =>
  localizedPath(path, languageFromPath(Astro.url.pathname));
---

<Site title={t("Page not found")}>
  <section class="error-page wrap">
    <span class="eyebrow">{t("404 / AN UNFINISHED CONNECTION")}</span>
    <h1 lang={textLanguage(t("This path leads"), t("somewhere else."))}>
      {t("This path leads")}<br /><em>{t("somewhere else.")}</em>
    </h1>
    <p>{t("The page may have moved, or the address might be a little off.")}</p>
    <a class="button" href={local("/")}>{t("Back to the beginning ↗")}</a>
  </section>
</Site>
