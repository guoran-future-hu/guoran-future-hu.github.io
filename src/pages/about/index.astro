---
import { textLanguage, translator } from "../../lib/i18n";
import ExperienceTimeline from "../../components/ExperienceTimeline.astro";
import Site from "../../layouts/Site.astro";
const t = translator(Astro.url.pathname);
---

<Site
  title={t("About")}
  description="I'm Guoran Hu, also known as Future. An AI researcher, builder, and curious generalist studying machine learning at MBZUAI."
>
  <div class="wrap">
    <section class="about-hero">
      <div>
        <header class="page-intro">
          <p class="eyebrow">{t("A PERSON BEHIND THE IDEAS")}</p>
          <h1 lang={textLanguage(t("Hi, I’m Guoran."), t("Call me"))}>
            {t("Hi, I’m Guoran.")}<br />{t("Call me")}{" "}
            <em class="inline-emphasis">Future.</em>
          </h1>
          <p>
            {
              t(
                "I read too many of Asimov’s robot stories as a kid. They sent me toward AI—and toward bigger questions about what intelligence means for the world we’re building.",
              )
            }
          </p>
        </header>
        <a class="text-link" href="mailto:i2754067952@gmail.com"
          >{t("Say hello")} <span aria-hidden="true">↗</span></a
        >
      </div>
      <figure>
        <div class="portrait-pair">
          <img
            class="about-portrait"
            src="/assets/images/pfp.jpg"
            alt="Guoran Hu"
            width="360"
            height="450"
          />
          <img
            class="about-portrait about-portrait-second"
            src="/assets/images/pfp2.jpg"
            alt="Guoran wearing glasses and a headband, looking to the side"
            width="360"
            height="450"
          />
        </div>
        <figcaption class="portrait-caption">
          <span>GUORAN “FUTURE” HU</span><span>{t("ABU DHABI, UAE")}</span>
        </figcaption>
      </figure>
    </section>
    <section class="about-section">
      <h2 lang={textLanguage(t("Across the boundaries."))}>
        <span class="eyebrow">{t("THE WAY I LOOK AT THINGS")}</span>{
          t("Across the boundaries.")
        }
      </h2>
      <div class="about-body">
        <p>
          {
            t(
              "I’m drawn to the connections between AI, philosophy, economics, and complex systems. Each gives me a different way to look at the same world. None feels sufficient on its own.",
            )
          }
        </p>
        <p>
          {
            t(
              "My research interests center on world models: how machines can represent their surroundings, simulate what might happen, and learn to act. I’m interested in generative models, reinforcement learning, robotics, and the safety questions that come with more capable agents.",
            )
          }
        </p>
        <p>
          {
            t(
              "Outside research, I enjoy tinkering with small side projects for fun, following an idea and seeing where it leads.",
            )
          }
        </p>
      </div>
    </section>
    <section id="now" class="about-section">
      <h2 lang={textLanguage(t("Learning by doing."))}>
        <span class="eyebrow">{t("CURRENTLY & ALONG THE WAY")}</span>{
          t("Learning by doing.")
        }
      </h2>
      <div>
        <ExperienceTimeline />
      </div>
    </section>
    <section class="about-section">
      <h2 lang={textLanguage(t("A little more human."))}>
        <span class="eyebrow">{t("AWAY FROM THE SCREEN")}</span>{
          t("A little more human.")
        }
      </h2>
      <div class="about-body">
        <p>
          {
            t(
              "Science fiction is still on the reading list, especially when it’s written by people who know their subject deeply. I love classical music and spent some time teaching myself the violin.",
            )
          }
        </p>
        <p>
          {
            t(
              "I’m also a certified scuba diver, with thanks to the Hart House Underwater Club at the University of Toronto. There’s a lot to explore outside a model of the world, too.",
            )
          }
        </p>
        <div class="interest-links">
          <a href="https://www.youtube.com/watch?v=WcA0odcNuJU"
            >{t("A little violin ↗")}</a
          ><a href="https://www.youtube.com/watch?v=hKapxQDui50"
            >{t("Below the surface ↗")}</a
          ><a href="https://www.youtube.com/watch?v=OQ43KjLR0yU"
            >{t("Outdoors ↗")}</a
          ><a href="https://www.instagram.com/gr.future.hu/">Instagram ↗</a>
        </div>
      </div>
    </section>
  </div>
</Site>
