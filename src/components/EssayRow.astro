---
import { formatDate, type Entry } from "../lib/content";
interface Props {
  post: Entry;
  index?: number;
}
const { post, index = 0 } = Astro.props;
---

<article
  class="essay-row"
  data-essay
  data-search={`${post.title} ${post.description} ${post.category}`.toLowerCase()}
  data-category={post.category}
>
  <span class="row-number">{String(index + 1).padStart(2, "0")}</span>
  <div class="essay-row-main">
    <p class="eyebrow">{post.category}</p>
    <h3>
      <a href={post.url}>{post.title}</a>
    </h3>
    <p class="essay-description">{post.description}</p>
  </div>
  <div class="essay-row-meta">
    <time datetime={post.date.toISOString()}>{formatDate(post.date)}</time><span
      >{post.minutes} min read</span
    ><a href={post.url} aria-label={`Read ${post.title}`} class="row-arrow">↗</a
    >
  </div>
</article>
