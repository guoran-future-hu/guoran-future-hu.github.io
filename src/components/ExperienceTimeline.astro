---
import {
  textLanguage,
  translator,
  localizedPath,
  languageFromPath,
} from "../lib/i18n";

const t = translator(Astro.url.pathname);
const local = (path: string) =>
  localizedPath(path, languageFromPath(Astro.url.pathname));
---

<div class="timeline-row">
  <span>{t("2025 — NOW")}<br />{t("Abu Dhabi")}</span>
  <div>
    <h3 lang="en">MBZUAI</h3>
    <p>
      {t("MSc in Machine Learning.")}<br />{t("Supervisor: Xue (Steve) Liu.")}
    </p>
  </div>
</div>

<div class="timeline-row">
  <span>2025<br />{t("Beijing")}</span>
  <div>
    <h3 lang={textLanguage(t("Tuojing Intelligence"))}>
      {t("Tuojing Intelligence")}
    </h3>
    <p>
      {
        t(
          "AI Researcher Intern. Novel view synthesis and 3D / 4D reconstruction for self-driving cars. Contributed to",
        )
      }
      <a class="text-link" href={local("/projects/ReconDrive/")}>ReconDrive ↗</a
      >.
    </p>
  </div>
</div>
<div class="timeline-row">
  <span>2023 — 2024<br />{t("Mississauga")}</span>
  <div>
    <h3 lang="en">UTEX Scientific Instruments</h3>
    <p>
      {
        t(
          "AI Engineer & Software Engineer Intern. Neural networks and workflows for automated ultrasound signal analysis.",
        )
      }
    </p>
  </div>
</div>
<div class="timeline-row">
  <span>2020 — 2024<br />{t("Toronto")}</span>
  <div>
    <h3 lang={textLanguage(t("University of Toronto"))}>
      {t("University of Toronto")}
    </h3>
    <p>
      {
        t(
          "BSc in Computer Science. A foundation in computing, and an enduring interest in cognitive science.",
        )
      }
    </p>
  </div>
</div>
