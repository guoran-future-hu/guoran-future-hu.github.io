---
import {
  textLanguage,
  translator,
  languageFromPath,
  localizedPath,
} from "../lib/i18n";
import type { Entry } from "../lib/content";
import { projectPresentation } from "../lib/projects";
interface Props {
  project: Entry;
}
const { project } = Astro.props;
const presentation = projectPresentation[project.slug];
const isRoundtable = presentation?.visual === "roundtable";
const title = presentation?.title ?? project.title;
const image = presentation?.image ?? project.image;
const t = translator(Astro.url.pathname);
const url = localizedPath(project.url, languageFromPath(Astro.url.pathname));
---

<article class="project-card">
  <a
    href={url}
    class:list={[
      "project-visual",
      isRoundtable ? "roundtable-visual" : "recon-visual",
    ]}
    aria-label={`Explore ${project.title}`}
  >
    {
      isRoundtable ? (
        <div class="roundtable-art" lang="en" aria-hidden="true">
          <span class="persona persona-one">The first-principles thinker</span>
          <span class="persona persona-two">The builder</span>
          <span class="persona persona-three">The contrarian</span>
          <span class="roundtable-center">
            One question.
            <br />
            <em>Many perspectives.</em>
          </span>
          <span class="table-orbit" />
        </div>
      ) : image ? (
        <img src={image} alt={presentation?.imageAlt ?? title} loading="lazy" />
      ) : (
        <span class="project-placeholder">{title}</span>
      )
    }
    <span class="project-visual-arrow" aria-hidden="true">↗</span>
  </a>
  <div class="project-meta">
    <span class="eyebrow">{t(project.category)}</span><span
      >{project.date.getUTCFullYear()}</span
    >
  </div>
  <h3 lang={textLanguage(title)}>
    <a href={url}>{title}</a>
  </h3>
  <p>{t(project.description)}</p>
  <a class="text-link" href={url}
    >{t(presentation?.linkLabel ?? "View project")}
    <span aria-hidden="true">↗</span></a
  >
</article>
