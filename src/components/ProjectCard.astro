---
import type { Entry } from "../lib/content";
interface Props {
  project: Entry;
}
const { project } = Astro.props;
const isRoundtable = project.slug === "Persona-Roundtable";
---

<article class="project-card">
  <a
    href={project.url}
    class:list={[
      "project-visual",
      isRoundtable ? "roundtable-visual" : "recon-visual",
    ]}
    aria-label={`Explore ${project.title}`}
  >
    {
      isRoundtable ? (
        <div class="roundtable-art" aria-hidden="true">
          <>
            <span class="persona persona-one">
              The first-principles thinker
            </span>
            <span class="persona persona-two">The builder</span>
            <span class="persona persona-three">The contrarian</span>
            <span class="roundtable-center">
              One question.
              <>
                <br />
                <em>Many perspectives.</em>
              </>
            </span>
            <span class="table-orbit" />
          </>
        </div>
      ) : (
        <img
          src="/assets/images/recon-drive-visualization.png"
          alt="ReconDrive reconstructions of autonomous driving scenes"
          loading="lazy"
        />
      )
    }
    <span class="project-visual-arrow" aria-hidden="true">↗</span>
  </a>
  <div class="project-meta">
    <span class="eyebrow">{project.category}</span><span
      >{project.date.getUTCFullYear()}</span
    >
  </div>
  <h3>
    <a href={project.url}
      >{
        isRoundtable
          ? "Persona Roundtable"
          : project.slug === "ReconDrive"
            ? "ReconDrive"
            : project.title
      }</a
    >
  </h3>
  <p>{project.description}</p>
  <a class="text-link" href={project.url}
    >{isRoundtable ? "View project" : "Explore the research"}
    <span aria-hidden="true">↗</span></a
  >
</article>
