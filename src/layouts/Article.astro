---
import Site from "./Site.astro";
import EssayRow from "../components/EssayRow.astro";
import { posts, formatDate, type Entry } from "../lib/content";
interface Props {
  entry: Entry;
  project?: boolean;
}
const { entry, project = false } = Astro.props;
const related = posts.filter((p) => p.slug !== entry.slug).slice(0, 2);
---

<Site
  title={entry.title}
  description={entry.description}
  image={entry.image}
  article
>
  <progress
    class="reading-progress"
    max="100"
    value="0"
    aria-label="Reading progress"></progress>
  <div class="article-wrap wrap">
    <header class="article-header">
      <a class="back-link" href={project ? "/projects/" : "/blogs/"}
        >← Back to {project ? "projects" : "writing"}</a
      >
      <p class="eyebrow">{entry.category}</p>
      <h1>{entry.title}</h1>
      <div class="article-byline">
        <span>Guoran Hu</span><span aria-hidden="true">/</span><time
          datetime={entry.date.toISOString()}>{formatDate(entry.date)}</time
        >{
          !project && (
            <>
              <span aria-hidden="true">/</span>
              <span>{entry.minutes} min read</span>
            </>
          )
        }
      </div>
    </header>
    <div class="article-grid">
      <article class="prose" set:html={entry.html} />
      <aside class="article-sidebar">
        {
          entry.headings.length > 0 && (
            <nav aria-label="On this page">
              <p class="eyebrow">ON THIS PAGE</p>
              <ul>
                {entry.headings.map((heading) => (
                  <li>
                    <a href={`#${heading.id}`} set:html={heading.title} />
                  </li>
                ))}
              </ul>
            </nav>
          )
        }<p class="sidebar-note">
          {
            project
              ? "From the workshop: ideas put into practice."
              : "A snapshot of my thinking. Written in its own time, left open to future revision."
          }
        </p>
        <div class="article-actions">
          <button id="copy-link">Copy link ↗</button><a
            href="mailto:i2754067952@gmail.com">Discuss by email ↗</a
          >
        </div>
      </aside>
    </div>
    <div class="article-end">
      <p>Have a different perspective?</p>
      <a
        class="text-link"
        href={`mailto:i2754067952@gmail.com?subject=${encodeURIComponent(entry.title)}`}
        >I’d like to hear it <span aria-hidden="true">↗</span></a
      >
    </div>
    {
      !project && (
        <section class="related-essays">
          <h2>Keep following the thread.</h2>
          {related.map((post, index) => (
            <EssayRow post={post} index={index} />
          ))}
        </section>
      )
    }
  </div>
</Site>
<script>
  const progress =
    document.querySelector<HTMLProgressElement>(".reading-progress")!;
  function update() {
    const max = document.documentElement.scrollHeight - innerHeight;
    progress.value = max > 0 ? (scrollY / max) * 100 : 100;
  }
  document.addEventListener("scroll", update, { passive: true });
  window.addEventListener("resize", update);
  update();
  document
    .querySelector<HTMLButtonElement>("#copy-link")!
    .addEventListener("click", async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      try {
        await navigator.clipboard.writeText(location.href);
        button.textContent = "Link copied ✓";
      } catch {
        button.textContent = "Copy the URL from your address bar";
      }
    });
</script>
