---
import {
  textLanguage,
  translator,
  languageFromPath,
  localizedPath,
} from "../lib/i18n";
import Site from "./Site.astro";
import EssayRow from "../components/EssayRow.astro";
import { posts, formatDate, translatedEntry, type Entry } from "../lib/content";
interface Props {
  entry: Entry;
  project?: boolean;
}
const { entry: originalEntry, project = false } = Astro.props;
const language = languageFromPath(Astro.url.pathname);
const translation =
  language === "zh" ? translatedEntry(originalEntry, project) : undefined;
const entry = translation ?? originalEntry;
const related = posts.filter((p) => p.slug !== entry.slug).slice(0, 2);
const t = translator(Astro.url.pathname);
---

<Site
  title={entry.title}
  description={entry.description}
  image={entry.image}
  article
>
  <progress
    class="reading-progress"
    max="100"
    value="0"
    aria-label={t("Reading progress")}></progress>
  <div class="article-wrap wrap">
    <header class="article-header">
      <a
        class="back-link"
        href={localizedPath(project ? "/projects/" : "/blogs/", language)}
        >{
          language === "zh"
            ? project
              ? "← 返回项目"
              : "← 返回文章"
            : project
              ? "← Back to projects"
              : "← Back to writing"
        }</a
      >
      <p class="eyebrow">{t(entry.category)}</p>
      <h1 lang={textLanguage(t(entry.title))}>{t(entry.title)}</h1>
      <div class="article-byline">
        <span>Guoran Hu</span><span aria-hidden="true">/</span><time
          datetime={entry.date.toISOString()}
          >{formatDate(entry.date, language)}</time
        >{
          !project && (
            <>
              <span aria-hidden="true">/</span>
              <span>
                {entry.minutes} {language === "zh" ? "分钟阅读" : "min read"}
              </span>
            </>
          )
        }
      </div>
    </header>
    <div class="article-grid">
      <div>
        {
          language === "zh" && !translation && (
            <p class="translation-note">
              以下为英文正文；中文页面提供标题与摘要翻译。
              <br />
              {t(entry.description)}
            </p>
          )
        }
        <article
          class="prose"
          lang={translation ? "zh-CN" : "en"}
          set:html={entry.html}
        />
      </div>
      <aside class="article-sidebar">
        {
          entry.headings.length > 0 && (
            <nav aria-label={t("On this page")}>
              <p class="eyebrow">{t("ON THIS PAGE")}</p>
              <ul>
                {entry.headings.map((heading) => (
                  <li>
                    <a href={`#${heading.id}`} set:html={heading.title} />
                  </li>
                ))}
              </ul>
            </nav>
          )
        }<p class="sidebar-note">
          {
            project
              ? t("From the workshop: ideas put into practice.")
              : t(
                  "A snapshot of my thinking. Written in its own time, left open to future revision.",
                )
          }
        </p>
        <div class="article-actions">
          <button id="copy-link">{t("Copy link ↗")}</button><a
            href="mailto:i2754067952@gmail.com">{t("Discuss by email ↗")}</a
          >
        </div>
      </aside>
    </div>
    <div class="article-end">
      <p>{t("Have a different perspective?")}</p>
      <a
        class="text-link"
        href={`mailto:i2754067952@gmail.com?subject=${encodeURIComponent(entry.title)}`}
        >{t("I’d like to hear it")} <span aria-hidden="true">↗</span></a
      >
    </div>
    {
      !project && (
        <section class="related-essays">
          <h2 lang={textLanguage(t("Keep following the thread."))}>
            {t("Keep following the thread.")}
          </h2>
          {related.map((post, index) => (
            <EssayRow post={post} index={index} />
          ))}
        </section>
      )
    }
  </div>
</Site>
<script>
  const progress =
    document.querySelector<HTMLProgressElement>(".reading-progress")!;
  function update() {
    const max = document.documentElement.scrollHeight - innerHeight;
    progress.value = max > 0 ? (scrollY / max) * 100 : 100;
  }
  document.addEventListener("scroll", update, { passive: true });
  window.addEventListener("resize", update);
  update();
  document
    .querySelector<HTMLButtonElement>("#copy-link")!
    .addEventListener("click", async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      try {
        await navigator.clipboard.writeText(location.href);
        button.textContent =
          document.documentElement.lang === "zh-CN"
            ? "链接已复制 ✓"
            : "Link copied ✓";
      } catch {
        button.textContent =
          document.documentElement.lang === "zh-CN"
            ? "请复制浏览器地址栏中的链接"
            : "Copy the URL from your address bar";
      }
    });
</script>
